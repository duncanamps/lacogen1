//-----------------------------------------------------------------------------------
//
// LaCoGen - Test SR conflict
//
// 31/03/2020
//
// Test Shift/Reduce conflict
//
// A shift / reduce conlict occurs when the parser does not know whether to shift
// or reduce based on the input. For example if the input is <E> + <E> and another
// plus sign is see, is it shifted in, or is the first <E> + <E> reduced?
//
// There's the conflict. Aside from the warning, LaCoGen will deal with this
// situation by shifting.
//
// -----------------------------------------------------------------------------------
  
%title        = "LaCoGen TEST SR Conflict";
%version      = "0";
%author       = "Duncan Munro";
%codeprefix   = "SRC";
%start        = <E>;


// ====================================================================
// Predefined Character sets
// ====================================================================

{nset}       = [0-9];
                                  
// ====================================================================
// Terminals
// ====================================================================

n = {nset}+;


// ====================================================================
// Rules
// ====================================================================

<E> : n
    | <E> "+" <E>
    ;
    
